# Copy to deploy/.env.production on the production host. Do not commit the copy.
# Replace every placeholder before starting the stack.

# Public DNS names. Both must already resolve to this host before Caddy starts.
APP_DOMAIN=assistant.example.com
S3_PUBLIC_DOMAIN=storage.example.com
NEXT_PUBLIC_API_URL=https://assistant.example.com
CORS_ORIGINS=["https://assistant.example.com"]

# Database (use a unique hexadecimal password so it is safe inside DATABASE_URL)
POSTGRES_USER=knowledge_assistant
POSTGRES_PASSWORD=replace-with-a-64-character-hex-password
POSTGRES_DB=knowledge_assistant
DATABASE_URL=postgresql+psycopg2://knowledge_assistant:replace-with-the-same-64-character-hex-password@postgres:5432/knowledge_assistant

# Auth (generate with: openssl rand -hex 48)
JWT_SECRET_KEY=replace-with-a-long-random-signing-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production

# Object storage. These credentials are only for this stack's internal MinIO.
# Generate both with `openssl rand -hex 32`; S3_ACCESS_KEY/S3_SECRET_KEY must match.
MINIO_ROOT_USER=replace-with-a-64-character-hex-access-key
MINIO_ROOT_PASSWORD=replace-with-a-64-character-hex-secret-key
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://storage.example.com
S3_ACCESS_KEY=replace-with-the-same-64-character-hex-access-key
S3_SECRET_KEY=replace-with-the-same-64-character-hex-secret-key
S3_BUCKET_NAME=company-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# Internal services
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=org
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Model providers
GEMINI_API_KEY=replace-with-a-newly-rotated-Gemini-key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAG and upload limits
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHARACTERS=12000
CONVERSATION_MEMORY_TURNS=5
OCR_ENABLED=true
OCR_PROVIDER=tesseract
MAX_UPLOAD_SIZE_MB=25
